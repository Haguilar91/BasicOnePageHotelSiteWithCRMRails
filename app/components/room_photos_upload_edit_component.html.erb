<%= field_wrapper(**field_wrapper_args, full_width: true) do %>
  <%= render Avo::Fields::Common::Files::ListViewerComponent.new(field: @field, resource: @resource) if @field.value.present? %>

  <% if can_upload_file? %>
    <% upload_input_id = "#{@form.object_name}_#{@field.id}" %>
    <div class="gallery-upload" data-gallery-upload>
      <%= render Avo::UI::FileUploadInputComponent.new(
        id: upload_input_id,
        description: @field.accept.present? ? "Accepts #{@field.accept}" : "Accepts .jpg and .png",
        disabled: disabled?,
      ) do %>
        <%= @form.file_field @field.id,
          id: upload_input_id,
          accept: @field.accept,
          data: @field.get_html(:data, view: view, element: :input).merge(gallery_input: true),
          direct_upload: @field.direct_upload,
          disabled: disabled?,
          multiple: true,
          style: @field.get_html(:style, view: view, element: :input),
          autofocus: @autofocus
        %>
      <% end %>

      <p class="gallery-upload__hint">
        Puedes abrir el selector varias veces, o arrastrar y soltar en distintos momentos, para juntar fotos de varias carpetas antes de guardar &mdash; se van acumulando aqu&iacute; abajo.
      </p>

      <div class="gallery-upload__pending" data-gallery-pending></div>

      <button type="button" class="gallery-upload__clear hidden" data-gallery-clear>
        <%= t("avo.clear_value") %> (todas las pendientes)
      </button>
    </div>

    <style>
      .gallery-upload__hint {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2rem;
        color: var(--avo-color-primary-500, #6b7280);
      }

      .gallery-upload__pending {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
        gap: 0.75rem;
        margin-top: 0.75rem;
      }

      .gallery-upload__pending-item {
        position: relative;
        border-radius: 0.5rem;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        background: var(--avo-color-primary-100, #f3f4f6);
        border: 1px solid var(--avo-color-primary-200, #e5e7eb);
      }

      .gallery-upload__pending-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .gallery-upload__pending-item .gallery-upload__pending-name {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        font-size: 10px;
        line-height: 1.3;
        padding: 2px 4px;
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .gallery-upload__pending-item .gallery-upload__pending-remove {
        position: absolute;
        top: 3px;
        right: 3px;
        width: 18px;
        height: 18px;
        line-height: 16px;
        text-align: center;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.65);
        color: #fff;
        font-size: 12px;
        cursor: pointer;
        border: none;
        padding: 0;
      }

      .gallery-upload__pending-item .gallery-upload__pending-remove:hover {
        background: rgba(220, 38, 38, 0.9);
      }

      .gallery-upload__clear {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: #dc2626;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
      }

      .gallery-upload__clear.hidden {
        display: none;
      }
    </style>
  <% else %>
    &mdash;
  <% end %>
<% end %>
