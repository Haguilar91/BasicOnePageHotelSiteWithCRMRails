<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <%= stylesheet_link_tag "avo/dependencies", "data-turbo-track": "reload", as: "style" %>
<%= render Avo::AssetManager::StylesheetComponent.new asset_manager: Avo.asset_manager %>
<%= stylesheet_link_tag "avo/application", "data-turbo-track": "reload", as: "style" %>
<%= stylesheet_link_tag "avo-overrides", "data-turbo-track": "reload", as: "style" %>

<%= javascript_include_tag "avo/application", "data-turbo-track": "reload", defer: true, nonce: request.content_security_policy_nonce %>
<%= javascript_include_tag "avo-overrides", "data-turbo-track": "reload", defer: true, nonce: request.content_security_policy_nonce %>
<%= render Avo::AssetManager::JavascriptComponent.new asset_manager: Avo.asset_manager %>
  
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Allow pages to push to :head if needed %>
    <%= yield :head %>
  </head>

  <body>
    <header style="padding: 12px 16px; border-bottom: 1px solid #e5e7eb; background: #fff;">
      <div style="max-width: 1100px; margin: 0 auto; display:flex; justify-content:flex-end; gap:12px; align-items:center;">
        <% if defined?(current_user) && current_user %>
          <%= link_to "Profile", "/avo/profile", style: "color:#0b5fff; text-decoration:none; font-weight:500;" %>

          <%= link_to "Logout",
                      Rails.application.routes.url_helpers.destroy_user_session_path,
                      method: :delete,
                      data: { turbo_method: :delete },
                      style: "color:#ef4444; text-decoration:none; font-weight:500;" %>
        <% end %>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <%# Allow pages to push JS to :scripts if needed %>
    <%= yield :scripts %>
  </body>
</html>