<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= t("translations_panel.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag :app %>
    <%= javascript_include_tag "translations_panel", "data-turbo-track": "reload", defer: true %>
  </head>
  <body class="bg-slate-100 text-slate-900">
    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
