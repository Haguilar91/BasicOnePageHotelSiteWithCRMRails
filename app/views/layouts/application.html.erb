<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "announcements", "data-turbo-track": "reload", defer: true %>
  <%= javascript_include_tag "room_gallery", "data-turbo-track": "reload", defer: true %>
  <% if easy_edit_mode? %>
    <%= javascript_include_tag "easy_edit", "data-turbo-track": "reload", defer: true %>
  <% end %>
  <!-- Tailwind CSS (site-wide) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Dynamic Browser Tab Title from Avo -->
    <title><%= page_content('site_title', 'Hotel Boutique') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hotel Boutique">
    <meta name="mobile-web-app-capable" content="yes">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Active color theme, managed from Avo > Themes %>
    <% theme = Theme.current %>
    <style>
      :root {
        --color-bg-primary: <%= theme.bg_primary %>;
        --color-bg-secondary: <%= theme.bg_secondary %>;
        --color-bg-tertiary: <%= theme.bg_tertiary %>;
        --color-accent: <%= theme.accent %>;
        --color-accent-soft: <%= theme.accent_soft %>;
        --color-text-muted: <%= theme.text_muted %>;
      }
    </style>

    <%= yield :head %>

    <%# Dynamic Favicon & Apple Touch Icon from Avo Database %>
    <% brand_settings = PageContent.find_by(key: 'global') %>
    <% active_favicon = brand_settings&.favicon&.attached? ? brand_settings.favicon : (brand_settings&.logo&.attached? ? brand_settings.logo : nil) %>
    
    <% if active_favicon %>
      <% favicon_url = url_for(active_favicon) %>
      <link rel="icon" href="<%= favicon_url %>" type="image/png">
      <link rel="apple-touch-icon" href="<%= favicon_url %>">
    <% else %>
      <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <% end %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
  
    <%# Active announcements, plus any offer flagged to run in the ticker %>
    <% active_announcements = Announcement.where(active: true).where('start_date <= ? AND end_date >= ?', Time.current, Time.current) %>
    <% ticker_items = active_announcements.map { |a| { title: a.title, description: a.description } } %>
    <% ticker_items += Offer.on_ticker.ordered.includes(:room).map { |o| { title: o.display_title, description: o.ticker_text } } %>
    <% if ticker_items.any? %>
      <%= link_to announcements_path, class: "block cursor-pointer" do %>
        <div class="announcement-ribbon">
          <div class="ticker-wrapper">
            <div id="announcement-ticker" data-announcements="<%= ticker_items.to_json %>" data-speed="50"></div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= render "shared/flash" %>

    <% if easy_edit_mode? %>
      <div class="easy-edit-banner">
        <i class="fas fa-pen"></i> Easy Edit activado — haz clic en el ícono de lápiz para editar
        <%= link_to "Desactivar", disable_easy_edit_path, class: "easy-edit-banner__off" %>
      </div>

      <div class="fixed inset-0 z-[300] hidden items-center justify-center bg-black/60 p-4" data-easy-edit-modal>
        <div class="bg-white text-slate-900 rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-6" data-easy-edit-modal-content>
          <div class="flex justify-end">
            <button type="button" class="text-slate-400 hover:text-slate-700 text-xl leading-none" data-easy-edit-modal-close aria-label="Cerrar">&times;</button>
          </div>
          <div data-easy-edit-modal-body></div>
        </div>
      </div>

      <style>
        .easy-edit-banner {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          z-index: 250;
          background: #111827;
          color: #fff;
          text-align: center;
          font-size: 0.8rem;
          padding: 0.4rem 1rem;
        }
        .easy-edit-banner__off {
          margin-left: 0.75rem;
          color: #fca5a5;
          text-decoration: underline;
        }
        .easy-edit-editable {
          position: relative;
          outline: 1px dashed rgba(184, 134, 11, 0.5);
          outline-offset: 4px;
          cursor: pointer;
          border-radius: 0.25rem;
        }
        .easy-edit-editable:hover {
          outline-style: solid;
          background: rgba(184, 134, 11, 0.08);
        }
        .easy-edit-pencil {
          position: absolute;
          top: 0.5rem;
          right: 0.5rem;
          z-index: 20;
          width: 2rem;
          height: 2rem;
          border-radius: 9999px;
          background: rgba(17, 24, 39, 0.85);
          color: #fff;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 0.8rem;
          cursor: pointer;
          border: none;
        }
        .easy-edit-pencil:hover {
          background: var(--color-accent, #b8860b);
          color: #111827;
        }
      </style>
    <% end %>

    <%= yield %>
  </body>
</html>