<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
<% @entries.each do |entry| %>
  <url>
    <loc><%= entry[:loc] %></loc>
    <% if entry[:lastmod] %>
    <lastmod><%= entry[:lastmod].utc.iso8601 %></lastmod>
    <% end %>
    <changefreq><%= entry[:changefreq] %></changefreq>
    <priority><%= entry[:priority] %></priority>
    <%# Google asks that every language version of a page be listed on every
        one of its entries, itself included, plus an x-default. %>
    <% entry[:alternates].each do |code, href| %>
    <xhtml:link rel="alternate" hreflang="<%= code %>" href="<%= href %>"/>
    <% end %>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= entry[:alternates][I18n.default_locale.to_s] %>"/>
  </url>
<% end %>
</urlset>
