<% page_content = PageContent.find_by(key: 'global') %>

{
  "name": "<%= page_content&.site_name || "Hotel Meson" %>",
  "icons": [
    <% if page_content&.app_icon&.attached? %>
      {
        "src": "<%= url_for(page_content.app_icon, size: '512x512') %>",
        "type": "image/png",
        "sizes": "512x512"
      },
      {
        "src": "<%= url_for(page_content.app_icon, size: '192x192') %>",
        "type": "image/png",
        "sizes": "192x192"
      },
      {
        "src": "<%= url_for(page_content.app_icon, size: '96x96') %>",
        "type": "image/png",
        "sizes": "96x96"
      }
    <% else %>
      {
        "src": "/icon.png",
        "type": "image/png",
        "sizes": "512x512"
      },
      {
        "src": "/icon.png",
        "type": "image/png",
        "sizes": "192x192"
      },
      {
        "src": "/icon.png",
        "type": "image/png",
        "sizes": "96x96"
      }
    <% end %>
    <% unless page_content&.app_icon&.attached? %>
    {
      "src": "/icon-dark.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/icon-dark.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/icon-dark.png",
      "type": "image/png",
      "sizes": "96x96"
    },
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "512x512"
    }
    <% end %>
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": "<%= page_content&.site_description || "Hotel Meson" %>",
  "theme_color": "<%= page_content&.theme_color || "#4F46E5" %>",
  "background_color": "<%= page_content&.background_color || "#FFFFFF" %>"
}
