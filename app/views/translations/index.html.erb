<div class="max-w-5xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold"><%= t("translations_panel.title") %></h1>
    <%= link_to "← Avo", "/avo", class: "text-sm text-slate-500 hover:text-slate-800" %>
  </div>

  <%= form_with url: translations_path, method: :patch, local: true, html: { data: { "translations-form" => true } } do %>
    <div class="space-y-6">
      <% @sections.each do |section| %>
        <details class="bg-white rounded-xl shadow-sm border border-slate-200" open>
          <summary class="cursor-pointer select-none px-5 py-4 font-semibold text-lg flex items-center justify-between">
            <span><%= section[:label] %> <span class="text-slate-400 font-normal text-sm">(<%= section[:records].size %>)</span></span>
            <button type="button" class="text-sm font-normal text-[var(--color-accent,#b8860b)] hover:underline" data-translate-section>
              <%= t("translations_panel.translate_all") %>
            </button>
          </summary>

          <div class="border-t border-slate-200 divide-y divide-slate-200">
            <% section[:records].each do |record| %>
              <div class="px-5 py-4">
                <p class="text-sm font-medium text-slate-500 mb-3"><%= record[:label] %></p>
                <div class="space-y-3">
                  <% record[:fields].each do |field| %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-start" data-translate-row>
                      <div>
                        <label class="block text-xs uppercase tracking-wide text-slate-400 mb-1">
                          <%= field[:name] %> — <%= t("translations_panel.spanish_label") %>
                        </label>
                        <% if field[:type] == :textarea %>
                          <textarea class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm" rows="3" readonly data-translate-source><%= field[:es] %></textarea>
                        <% else %>
                          <input type="text" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm" value="<%= field[:es] %>" readonly data-translate-source>
                        <% end %>
                      </div>
                      <div>
                        <div class="flex items-center justify-between mb-1">
                          <label class="block text-xs uppercase tracking-wide text-slate-400">
                            <%= field[:name] %> — <%= t("translations_panel.english_label") %>
                          </label>
                          <button type="button"
                                  class="text-xs font-semibold text-[var(--color-accent,#b8860b)] hover:underline"
                                  data-translate-field
                                  data-multiline="<%= field[:multiline] %>">
                            <%= t("translations_panel.translate") %>
                          </button>
                        </div>
                        <% field_name = "translations[#{section[:param_key]}][#{record[:id]}][#{field[:name]}]" %>
                        <% if field[:type] == :textarea %>
                          <textarea name="<%= field_name %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-[var(--color-accent,#b8860b)] focus:outline-none" rows="3" data-translate-target><%= field[:en] %></textarea>
                        <% else %>
                          <input type="text" name="<%= field_name %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-[var(--color-accent,#b8860b)] focus:outline-none" value="<%= field[:en] %>" data-translate-target>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <div class="sticky bottom-0 mt-6 py-4 bg-slate-100/95 backdrop-blur">
      <%= submit_tag t("translations_panel.save"), class: "px-6 py-3 rounded-full font-semibold bg-slate-900 text-white hover:bg-slate-700 transition cursor-pointer" %>
    </div>
  <% end %>
</div>
