<% content_for :title, "Anuncios" %>

<div class="min-h-screen bg-slate-50">
  <!-- Page header -->
  <div class="bg-[var(--color-bg-primary)] pt-28 pb-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-[var(--color-accent)] font-semibold tracking-wide uppercase text-sm mb-2">Hotel Mesón del Bosque</p>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-white mb-3">Anuncios y Promociones</h1>
      <p class="text-white/80 max-w-2xl mx-auto">Entérate de nuestras últimas ofertas, eventos y novedades.</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 -mt-10 pb-20">
    <% if notice.present? %>
      <div class="mb-6 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 text-sm">
        <%= notice %>
      </div>
    <% end %>

    <% if @announcements.any? %>
      <div id="announcements" class="grid gap-6 sm:grid-cols-2">
        <% @announcements.each do |announcement| %>
          <%= link_to announcement, class: "block" do %>
            <%= render announcement %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @offers.any? %>
      <h2 class="text-2xl font-serif font-bold text-slate-900 <%= @announcements.any? ? 'mt-12' : '' %> mb-6">Ofertas vigentes</h2>
      <div id="offers" class="grid gap-6 sm:grid-cols-2">
        <% @offers.each do |offer| %>
          <div class="bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden p-6">
            <div class="flex items-start justify-between gap-4 mb-3">
              <h3 class="text-xl font-bold text-slate-900"><%= offer.display_title %></h3>
              <% if offer.display_badge.present? %>
                <span class="shrink-0 inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700 uppercase">
                  <%= offer.display_badge %>
                </span>
              <% end %>
            </div>

            <% if offer.display_description.present? %>
              <p class="text-slate-600 leading-relaxed mb-4"><%= offer.display_description %></p>
            <% end %>

            <% if offer.room_offer? && offer.discounted_price.present? %>
              <p class="mb-4">
                <span class="text-slate-400 line-through mr-2"><%= offer.original_price %></span>
                <span class="text-lg font-bold text-slate-900"><%= offer.discounted_price %></span>
              </p>
            <% elsif offer.package_offer? && offer.price.present? %>
              <p class="mb-4 text-lg font-bold text-slate-900"><%= number_to_currency(offer.price) %></p>
            <% end %>

            <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm text-slate-400 border-t border-slate-100 pt-4">
              <% if offer.validity_label.present? %>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span><%= offer.validity_label %></span>
                </div>
              <% end %>
              <%= link_to "Ver en el sitio →", root_path(anchor: "ofertas"), class: "font-medium text-slate-600 hover:text-[var(--color-accent)] transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @announcements.none? && @offers.none? %>
      <div class="bg-white rounded-2xl shadow-md border border-slate-100 p-12 text-center">
        <p class="text-slate-500">No hay anuncios ni ofertas disponibles por el momento.</p>
      </div>
    <% end %>

    <div class="mt-10 text-center">
      <%= link_to "← Volver al inicio", root_path, class: "inline-flex items-center gap-2 text-slate-600 hover:text-[var(--color-accent)] font-medium transition-colors" %>
    </div>
  </div>
</div>
