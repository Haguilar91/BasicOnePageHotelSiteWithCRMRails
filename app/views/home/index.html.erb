        </button>
        <button type="button" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 text-white text-xl flex items-center justify-center hover:bg-white/20 transition" data-room-gallery-modal-prev aria-label="<%= t('gallery.previous_photo') %>">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button type="button" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 text-white text-xl flex items-center justify-center hover:bg-white/20 transition" data-room-gallery-modal-next aria-label="<%= t('gallery.next_photo') %>">
