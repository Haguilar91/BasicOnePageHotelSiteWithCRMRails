                        <i class="fas fa-pen"></i>
                    </button>
                  <% end %>
                  <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-[var(--color-bg-tertiary)] flex items-center justify-center transition hover:scale-110 duration-300">
                      <i class="fas fa-<%= feature.icon.presence || 'star' %> text-[var(--color-accent)] text-3xl"></i>
                  </div>
                  <h3 class="text-xl font-serif font-semibold mb-2"><%= feature.title %></h3>
                  <p class="text-[var(--color-text-muted)]"><%= feature.description %></p>
              </div>
            <% end %>
        </div>
    </div>
</section>
    <!-- Rooms Section -->
    <section id="habitaciones" class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 fade-in">
                <p class="text-[var(--color-accent)] tracking-widest mb-2 uppercase text-sm"><%= editable_content('home_features_title', 'Nuestras Habitaciones') %></p>
                <h2 class="text-4xl md:text-5xl font-serif font-bold"><%= editable_content('home_features_subtitle', 'Habitaciones Premium', tag: :span) %></h2>
                <p class="text-[var(--color-text-muted)] mt-4 max-w-2xl mx-auto"><%= editable_content('home_rooms_tagline', 'Diseñadas para brindarte la máxima comodidad y tranquilidad') %></p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <% (@rooms.presence || Room.order(:position, :id)).each do |room| %>
                <% room_photo_urls = room.gallery_photos.map { |p| url_for(p) }.presence || ["https://images.unsplash.com/photo-1590490360182-c33d57733427?w=800&q=80"] %>
                <div class="room-card bg-[var(--color-bg-secondary)] rounded-2xl overflow-hidden shadow-xl <%= 'border-2 border-[var(--color-accent)]/30' if room.badge.present? %> fade-in">
                    <div class="relative h-64 overflow-hidden room-gallery" data-room-gallery data-room-name="<%= room.name %>" data-photos="<%= room_photo_urls.to_json %>">
                        <div class="room-gallery-track flex h-full transition-transform duration-500 ease-out" style="width: <%= room_photo_urls.size * 100 %>%;">
                          <% room_photo_urls.each do |url| %>
                            <div class="h-full flex-shrink-0" style="width: <%= 100.0 / room_photo_urls.size %>%;">
                              <img src="<%= url %>"
                                   alt="<%= room.name %>"
                                   class="w-full h-full object-cover cursor-zoom-in"
                                   data-room-gallery-open>
                            </div>
                          <% end %>
                        </div>

                        <% if room_photo_urls.size > 1 %>
                          <button type="button" class="room-gallery-nav absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-black/60 transition" data-room-gallery-prev aria-label="<%= t('gallery.previous_photo') %>">
                              <i class="fas fa-chevron-left text-xs"></i>
                          </button>
                          <button type="button" class="room-gallery-nav absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-black/60 transition" data-room-gallery-next aria-label="<%= t('gallery.next_photo') %>">
                              <i class="fas fa-chevron-right text-xs"></i>
                          </button>
                          <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10" data-room-gallery-dots>
                            <% room_photo_urls.each_with_index do |_, i| %>
                              <span class="w-1.5 h-1.5 rounded-full <%= i.zero? ? 'bg-white' : 'bg-white/40' %> room-gallery-dot transition" data-index="<%= i %>"></span>
                            <% end %>
                          </div>
                        <% end %>
                        <% room_offer = @room_offers[room.id] %>
                        <% room_discounted = room_offer&.discounted_price %>
                        <% if room_discounted.present? %>
                          <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-slate-900 px-3 py-1 rounded-full text-sm font-semibold flex items-baseline gap-2">
                              <span class="line-through opacity-60 font-normal text-xs"><%= room.price %></span>
                              <span><%= room_discounted %></span>
                          </div>
                        <% elsif room.price.present? %>
                          <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-slate-900 px-3 py-1 rounded-full text-sm font-semibold">
                              <%= room.price %>
                          </div>
                        <% end %>
                        <% room_badge = room_offer&.display_badge.presence || room.badge %>
                        <% if room_badge.present? %>
                          <div class="absolute top-4 left-4 bg-[var(--color-accent)] text-slate-900 px-3 py-1 rounded-full text-xs font-bold uppercase">
                              <%= room_badge %>
                          </div>
                        <% end %>
                        <% if easy_edit_mode? %>
                          <button type="button" class="easy-edit-pencil" style="bottom: 0.75rem; right: 0.75rem; top: auto;" data-easy-edit-trigger data-easy-edit-resource="room" data-easy-edit-id="<%= room.id %>" aria-label="Editar habitación">
                              <i class="fas fa-pen"></i>
                          </button>
                        <% end %>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-serif font-semibold mb-2"><%= room.name %></h3>
                        <p class="text-[var(--color-text-muted)] mb-4"><%= room.description %></p>
                        <% if room.features.present? %>
                          <ul class="text-sm text-white/80 space-y-2 mb-6">
                            <% room.features.split("\n").map(&:strip).reject(&:empty?).each do |feature| %>
                              <li><i class="fas fa-check text-[var(--color-accent)] mr-2"></i> <%= feature %></li>
                            <% end %>
                          </ul>
                        <% end %>
                        <% if room.booking_url.present? %>
                          <a href="<%= room.booking_url %>" target="_blank" rel="noopener" class="block text-center <%= room.badge.present? ? 'bg-[var(--color-accent)] text-slate-900 hover:brightness-90 font-semibold' : 'bg-[var(--color-bg-tertiary)] hover:brightness-125' %> py-3 rounded-lg transition">
                              <i class="<%= room.booking_button_icon %> mr-2"></i><%= room.booking_button_label %>
                          </a>
                        <% else %>
                          <button type="button" data-book-modal-open class="block w-full text-center bg-[var(--color-bg-tertiary)] hover:brightness-125 py-3 rounded-lg transition">
                              <i class="fa-solid fa-calendar-check mr-2"></i><%= room.booking_button_label %>
                          </button>
                        <% end %>
                    </div>
                </div>
                <% end %>
            </div>
        </div>
    </section>

    <!-- Offers Section -->
    <% if @offers.present? %>
    <section id="ofertas" class="py-20 bg-[var(--color-bg-primary)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 fade-in">
                <p class="text-[var(--color-accent)] tracking-widest mb-2 uppercase text-sm"><%= t("offers.eyebrow") %></p>
                <h2 class="text-4xl md:text-5xl font-serif font-bold"><%= t("offers.heading") %></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <% @offers.each do |offer| %>
                <% offer_photo = offer.display_photo %>
                <% offer_badge = offer.display_badge %>
                <% booking_link = offer.booking_url.presence || (offer.room&.booking_url if offer.room_offer?) %>
                <div class="room-card bg-[var(--color-bg-secondary)] rounded-2xl overflow-hidden shadow-xl <%= 'border-2 border-[var(--color-accent)]/30' if offer_badge.present? %> fade-in">
                    <div class="relative h-64 overflow-hidden">
                        <% if offer_photo.present? %>
                          <img src="<%= url_for(offer_photo) %>"
                               alt="<%= offer.display_title %>"
                               class="w-full h-full object-cover">
                        <% else %>
                          <img src="https://images.unsplash.com/photo-1445019980597-93fa8acb246c?w=800&q=80"
                               alt="<%= offer.display_title %>"
                               class="w-full h-full object-cover">
                        <% end %>
                        <% if offer.room_offer? %>
                          <% if offer.discounted_price.present? %>
                            <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-slate-900 px-3 py-1 rounded-full text-sm font-semibold flex items-baseline gap-2">
                                <span class="line-through opacity-60 font-normal text-xs"><%= offer.original_price %></span>
                                <span><%= offer.discounted_price %></span>
                            </div>
                          <% elsif offer.original_price.present? %>
                            <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-slate-900 px-3 py-1 rounded-full text-sm font-semibold">
                                <%= offer.original_price %>
                            </div>
                          <% end %>
                        <% elsif offer.price.present? %>
                          <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-slate-900 px-3 py-1 rounded-full text-sm font-semibold">
                              <%= number_to_currency(offer.price) %>
                          </div>
                        <% end %>
                        <% if offer_badge.present? %>
                          <div class="absolute top-4 left-4 bg-[var(--color-accent)] text-slate-900 px-3 py-1 rounded-full text-xs font-bold uppercase">
                              <%= offer_badge %>
                          </div>
                        <% end %>
                        <% if easy_edit_mode? %>
                          <button type="button" class="easy-edit-pencil" style="bottom: 0.75rem; right: 0.75rem; top: auto;" data-easy-edit-trigger data-easy-edit-resource="offer" data-easy-edit-id="<%= offer.id %>" aria-label="Editar oferta">
                              <i class="fas fa-pen"></i>
                          </button>
                        <% end %>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-serif font-semibold mb-2"><%= offer.display_title %></h3>
                        <% if offer.display_description.present? %>
                          <p class="text-[var(--color-text-muted)] mb-2"><%= offer.display_description %></p>
                        <% end %>
                        <% if offer.validity_label.present? %>
                          <p class="text-sm text-[var(--color-accent)] mb-4">
                              <i class="fa-solid fa-clock mr-1"></i> <%= offer.validity_label %>
                          </p>
                        <% end %>
                        <% if booking_link.present? %>
                          <a href="<%= booking_link %>" target="_blank" rel="noopener" class="block text-center bg-[var(--color-accent)] text-slate-900 hover:brightness-90 font-semibold py-3 rounded-lg transition">
                              <i class="fa-solid fa-calendar-check mr-2"></i><%= t("offers.book_this_offer") %>
                          </a>
                        <% else %>
                          <button type="button" data-book-modal-open class="block w-full text-center bg-[var(--color-bg-tertiary)] hover:brightness-125 py-3 rounded-lg transition">
                              <i class="fa-solid fa-calendar-check mr-2"></i><%= t("offers.book_this_offer") %>
                          </button>
                        <% end %>
                    </div>
                </div>
                <% end %>
            </div>
        </div>
    </section>
    <% end %>

    <!-- Hotel Gallery Section (general hotel photos — lobby, terrace, facade,
         common areas — as opposed to each room's own gallery above) -->
    <% if @gallery_photos.present? %>
    <section id="galeria" class="py-20 bg-[var(--color-bg-secondary)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 fade-in">
                <p class="text-[var(--color-accent)] tracking-widest mb-2 uppercase text-sm"><%= t("gallery.eyebrow") %></p>
                <h2 class="text-4xl md:text-5xl font-serif font-bold"><%= t("gallery.heading") %></h2>
                <p class="text-[var(--color-text-muted)] mt-4 max-w-2xl mx-auto"><%= t("gallery.tagline") %></p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" data-hotel-gallery>
                <% @gallery_photos.each_with_index do |photo, index| %>
                  <div class="relative aspect-square rounded-xl overflow-hidden room-card">
                      <img src="<%= url_for(photo.photo) %>"
                           alt="<%= photo.caption.presence || t('gallery.heading') %>"
                           class="w-full h-full object-cover cursor-zoom-in"
                           data-hotel-gallery-open
                           data-index="<%= index %>">
                      <% if photo.caption.present? %>
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 py-2">
                            <span class="text-xs text-white/90"><%= photo.caption %></span>
                        </div>
                      <% end %>
                  </div>
                <% end %>
            </div>
        </div>
    </section>
    <% end %>

<!-- Services Section (Experiencias Extraordinarias) -->
    <section id="servicios" class="py-20 bg-[var(--color-bg-secondary)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 fade-in">
                <p class="text-[var(--color-accent)] tracking-widest mb-2 uppercase text-sm"><%= editable_content('services_title', 'Nuestros Servicios') %></p>
                <h2 class="text-4xl md:text-5xl font-serif font-bold"><%= editable_content('services_subtitle', 'Experiencias Extraordinarias') %></h2>
            </div>
            
            <!-- FIXED: Constrained max-width to 4xl, centered with mx-auto, and reduced to max 2 columns -->
            <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
                <% (@experiences.presence || Experience.order(:position, :id)).each_with_index do |exp, idx| %>
                <div class="relative testimonial-card p-8 rounded-2xl text-center floating" style="animation-delay: <%= idx * 0.2 %>s;">
                    <% if easy_edit_mode? %>
                      <button type="button" class="easy-edit-pencil" style="top: 0.5rem; right: 0.5rem;" data-easy-edit-trigger data-easy-edit-resource="experience" data-easy-edit-id="<%= exp.id %>" aria-label="Editar experiencia">
                          <i class="fas fa-pen"></i>
                      </button>
                    <% end %>
                    <% if exp.icon_image.attached? %>
                      <img src="<%= url_for(exp.icon_image) %>" alt="<%= exp.title %>" class="w-16 h-16 mx-auto mb-6 object-contain">
                    <% else %>
                      <i class="fas fa-<%= exp.icon.presence || 'star' %> text-5xl text-[var(--color-accent)] mb-6"></i>
                    <% end %>
                    <h3 class="text-xl font-semibold mb-3"><%= exp.title %></h3>
                    <p class="text-[var(--color-text-muted)]"><%= exp.description %></p>
                </div>
                <% end %>
            </div>
        </div>
    </section>

    <!-- Qué hacer Section -->
    <section id="que-hacer" class="py-20 bg-[var(--color-bg-primary)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12 fade-in">
                <p class="text-[var(--color-accent)] tracking-widest mb-2 uppercase text-sm"><%= t("activities.eyebrow") %></p>
                <h2 class="text-4xl md:text-5xl font-serif font-bold"><%= editable_content('home_activities_title', 'Qué hacer en Querétaro') %></h2>
                <p class="text-[var(--color-text-muted)] mt-4 max-w-2xl mx-auto"><%= editable_content('home_activities_subtitle', 'Restaurantes, puntos de interés y tours que hacen único tu viaje a Querétaro.') %></p>
            </div>

            <% activities_by_category = @local_activities.group_by(&:category) %>
            <div class="mb-10 fade-in">
                <div class="flex justify-center">
                    <div class="inline-flex rounded-full border border-white/10 bg-[var(--color-bg-secondary)] overflow-hidden">
                        <% LocalActivity::CATEGORIES.each_with_index do |category, index| %>
                            <button
                                type="button"
                                data-tab-button="<%= category.parameterize %>"
                                class="px-6 py-3 text-sm font-semibold transition <%= index.zero? ? 'bg-[var(--color-accent)] text-slate-900' : 'text-white/80 hover:bg-[var(--color-bg-tertiary)] hover:text-white' %>">
                                <%= LocalActivity.category_label(category) %>
                            </button>
                        <% end %>
                    </div>
                </div>
            </div>

            <% LocalActivity::CATEGORIES.each_with_index do |category, index| %>
                <% activities = activities_by_category[category] || [] %>
                <div data-tab-panel="<%= category.parameterize %>" class="<%= index.zero? ? '' : 'hidden' %>">
                    <% if activities.any? %>
                        <div class="grid gap-8 lg:grid-cols-2">
                            <% activities.each do |activity| %>
                                <div class="category-card rounded-3xl overflow-hidden bg-[var(--color-bg-secondary)] shadow-xl fade-in">
                                    <div class="relative h-72 overflow-hidden">
                                        <% if activity.photo.attached? %>
                                            <img src="<%= url_for(activity.photo) %>" alt="<%= activity.title %>" class="w-full h-full object-cover">
                                        <% else %>
                                            <img src="https://images.unsplash.com/featured/?<%= URI.encode_www_form_component(activity.title) %>&w=1200&q=80" alt="<%= activity.title %>" class="w-full h-full object-cover">
                                        <% end %>
                                        <% if easy_edit_mode? %>
                                          <button type="button" class="easy-edit-pencil" style="top: 0.75rem; right: 0.75rem;" data-easy-edit-trigger data-easy-edit-resource="local_activity" data-easy-edit-id="<%= activity.id %>" aria-label="Editar actividad">
                                              <i class="fas fa-pen"></i>
                                          </button>
                                        <% end %>
                                    </div>
                                    <div class="p-8">
                                        <div class="flex items-center justify-between mb-4">
                                            <div>
                                                <h3 class="text-2xl font-serif font-semibold text-white"><%= activity.title %></h3>
                                                <p class="text-[var(--color-text-muted)] text-sm mt-2"><%= LocalActivity.category_label(category) %></p>
                                            </div>
                                            <i class="fas fa-<%= category == 'Restaurantes' ? 'utensils' : (category == 'Puntos de Interés' ? 'map-marker-alt' : 'route') %> text-[var(--color-accent)] text-3xl"></i>
                                        </div>
                                        <p class="text-white/80 mb-6"><%= activity.description %></p>
                                        <a href="<%= activity.google_maps_url %>" target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-slate-900 transition hover:brightness-110">
                                            <i class="fas fa-map-marked-alt mr-2"></i> <%= t("activities.google_maps_button") %>
                                        </a>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    <% else %>
                        <div class="rounded-3xl border border-white/10 bg-[var(--color-bg-secondary)] p-10 text-center text-[var(--color-text-muted)] fade-in">
                            <%= t("activities.empty_state") %>
                        </div>
                    <% end %>
                </div>
            <% end %>
        </div>
    </section>

    <!-- Location Section -->
