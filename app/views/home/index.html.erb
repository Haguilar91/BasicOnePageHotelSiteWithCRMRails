    <!-- CTA Section -->
    <section id="reservar" class="py-20 relative overflow-hidden">
        <div class="absolute inset-0 bg-[var(--color-accent)]/10"></div>
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center fade-in">
