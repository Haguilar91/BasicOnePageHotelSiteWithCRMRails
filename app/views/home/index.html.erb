                        <i class="fas fa-pen"></i>
                    </button>
                  <% end %>
                </div>
              <% end %>
              <% if cta_button_enabled?(:whatsapp) %>
                <div class="relative inline-block">
                  <button type="button" data-book-modal-open data-book-channel="whatsapp" class="bg-[#25D366] text-white hover:brightness-110 px-10 py-4 rounded-full font-bold text-lg transition inline-flex items-center justify-center">
                      <i class="fa-brands fa-whatsapp mr-2"></i> <%= t("cta.send_whatsapp") %>
                  </button>
                  <% if easy_edit_mode? %>
                    <button type="button" class="easy-edit-pencil" style="position: absolute; top: -0.5rem; right: -0.5rem; bottom: auto;" data-easy-edit-trigger data-easy-edit-resource="page_content" data-easy-edit-id="contact_phone" aria-label="Editar número de WhatsApp">
                        <i class="fas fa-pen"></i>
                    </button>
                  <% end %>
                </div>
              <% end %>
              <% if cta_button_enabled?(:email) %>
                <div class="relative inline-block">
                  <button type="button" data-book-modal-open data-book-channel="email" class="bg-[var(--color-bg-tertiary)] hover:brightness-125 px-10 py-4 rounded-full font-bold text-lg transition inline-flex items-center justify-center">
                      <i class="fas fa-envelope mr-2"></i> <%= t("cta.send_email") %>
                  </button>
                  <% if easy_edit_mode? %>
                    <button type="button" class="easy-edit-pencil" style="position: absolute; top: -0.5rem; right: -0.5rem; bottom: auto;" data-easy-edit-trigger data-easy-edit-resource="page_content" data-easy-edit-id="contact_email" aria-label="Editar correo de contacto">
