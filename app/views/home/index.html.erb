    <!-- Booking / Check Availability Modal -->
    <% booking_phone = page_content('contact_phone', '+52 442 212 3456') %>
    <% booking_phone_digits = booking_phone.to_s.gsub(/\D/, '') %>
    <% booking_email = page_content('contact_email', 'info@hotelmeson.com') %>
    <% booking_fb_url = page_content('social_facebook') %>
    <% booking_messenger_username = booking_fb_url.present? ? booking_fb_url.to_s.sub(%r{\Ahttps?://(www\.)?(facebook|fb)\.com/}i, '').split(/[\/?]/).first.presence : nil %>
    <%# Which channels the guest may pick from to be contacted back — this also
        drives how the form itself reaches the hotel (e.g. picking WhatsApp
        sends a WhatsApp message to the hotel's number; picking Call still
        can't ring anyone by itself, so it's relayed by email like a written
        note). WhatsApp/Email/Call ride the same admin "show CTA button"
        switches (Avo > Contenidos de página > 'global') that gate the
        matching button in the CTA section. %>
    <% booking_channels = {} %>
    <% booking_channels["whatsapp"] = ["fa-brands fa-whatsapp", t("booking.channel_whatsapp")] if cta_button_enabled?(:whatsapp) %>
    <% booking_channels["email"] = ["fa-solid fa-envelope", t("booking.channel_email")] if cta_button_enabled?(:email) %>
    <% booking_channels["imessage"] = ["fa-brands fa-apple", t("booking.channel_imessage")] %>
    <% booking_channels["messenger"] = ["fa-brands fa-facebook-messenger", t("booking.channel_messenger")] if booking_messenger_username.present? %>
    <% booking_channels["sms"] = ["fa-solid fa-comment-sms", t("booking.channel_sms")] %>
    <% booking_channels["call"] = ["fa-solid fa-phone", t("booking.channel_call")] if cta_button_enabled?(:call) %>
    <div class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/70 p-4"
         data-booking-modal
         data-phone="<%= booking_phone_digits %>"
         data-email="<%= booking_email %>"
         data-email-subject="<%= t('booking.email_subject') %>"
         data-messenger-username="<%= booking_messenger_username %>"
         data-message-template="<%= t('booking.message_template') %>"
         data-locale="<%= I18n.locale %>">
        <div class="bg-[var(--color-bg-secondary)] text-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-6 md:p-8 relative">
            <button type="button" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition" data-booking-modal-close aria-label="<%= t('booking.close') %>">
                <i class="fas fa-times"></i>
            </button>

            <h3 class="text-2xl font-serif font-bold mb-1 pr-8"><%= t('booking.title') %></h3>
            <p class="text-[var(--color-text-muted)] text-sm mb-6"><%= t('booking.subtitle') %></p>

            <form data-booking-form novalidate>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-1" for="booking-checkin"><%= t('booking.checkin_label') %></label>
                        <input type="date" id="booking-checkin" name="checkin" required
                               class="w-full rounded-lg bg-[var(--color-bg-tertiary)] border border-white/10 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]">
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-1" for="booking-checkout"><%= t('booking.checkout_label') %></label>
                        <input type="date" id="booking-checkout" name="checkout" required
                               class="w-full rounded-lg bg-[var(--color-bg-tertiary)] border border-white/10 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]">
                    </div>
                </div>

                <div class="mb-4">
                    <span class="block text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-2"><%= t('booking.channel_label') %></span>
                    <div class="grid grid-cols-3 gap-2">
                        <% booking_channels.each_with_index do |(value, (icon_class, label)), index| %>
                          <label class="flex flex-col items-center justify-center gap-1 rounded-lg border border-white/10 bg-[var(--color-bg-tertiary)] py-3 text-xs text-center cursor-pointer transition hover:border-[var(--color-accent)]/60 has-[:checked]:border-[var(--color-accent)] has-[:checked]:bg-[var(--color-accent)]/10 has-[:checked]:text-[var(--color-accent)]">
                              <input type="radio" name="channel" value="<%= value %>" class="sr-only" <%= "checked" if index.zero? %>>
                              <i class="<%= icon_class %> text-lg"></i>
                              <span><%= label %></span>
                          </label>
                        <% end %>
                    </div>
                </div>

                <div class="mb-4" data-booking-phone-group>
                    <label class="block text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-1" for="booking-contact-phone"><%= t('booking.phone_label') %></label>
                    <div class="flex gap-2">
                        <select id="booking-country-code"
                                class="rounded-lg bg-[var(--color-bg-tertiary)] border border-white/10 px-2 py-2 text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]">
                            <% CountryCallingCode.all.each do |country| %>
                              <option value="<%= country.dial_code %>" title="<%= country.name %>" <%= "selected" if country.iso2 == "MX" %>><%= country.flag %> <%= country.iso2 %> <%= country.dial_code %></option>
                            <% end %>
                        </select>
                        <input type="tel" id="booking-contact-phone" placeholder="<%= t('booking.phone_placeholder') %>"
                               class="flex-1 min-w-0 rounded-lg bg-[var(--color-bg-tertiary)] border border-white/10 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]">
                    </div>
                </div>

                <div class="mb-4 hidden" data-booking-email-group>
                    <label class="block text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-1" for="booking-contact-email"><%= t('booking.contact_email_label') %></label>
                    <input type="email" id="booking-contact-email" placeholder="<%= t('booking.contact_email_placeholder') %>"
                           class="w-full rounded-lg bg-[var(--color-bg-tertiary)] border border-white/10 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]">
                </div>

                <p class="text-xs text-[var(--color-text-muted)] mb-4 hidden" data-booking-call-note><%= t('booking.call_note') %></p>

                <button type="submit" class="btn-gold text-slate-900 w-full py-3 rounded-full font-bold text-lg hover:shadow-xl hover:shadow-[var(--color-accent)]/50 transition">
                    <%= t('booking.submit') %>
                </button>
            </form>
        </div>
    </div>

    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Fade in animation on scroll
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.fade-in').forEach(el => {
            observer.observe(el);
        });

        // Navbar background on scroll
        const nav = document.querySelector('nav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                nav.classList.add('bg-[var(--color-bg-primary)]/95');
            } else {
                nav.classList.remove('bg-[var(--color-bg-primary)]/95');
            }
        });

        // Tab navigation for local activities
        document.querySelectorAll('[data-tab-button]').forEach(button => {
            button.addEventListener('click', () => {
                const target = button.dataset.tabButton;

                document.querySelectorAll('[data-tab-button]').forEach(btn => {
                    btn.classList.remove('bg-[var(--color-accent)]', 'text-slate-900');
                    btn.classList.add('text-white/80');
                });

                document.querySelectorAll('[data-tab-panel]').forEach(panel => {
                    panel.classList.add('hidden');
                });

                button.classList.add('bg-[var(--color-accent)]', 'text-slate-900');
                button.classList.remove('text-white/80');

                const activePanel = document.querySelector(`[data-tab-panel="${target}"]`);
                if (activePanel) {
                    activePanel.classList.remove('hidden');
                }
            });
        });
        
// Mobile bottom nav — highlight active section on scroll
const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
const sections = ['inicio', 'habitaciones', 'servicios', 'que-hacer', 'contacto', 'reservar']
    .map(id => document.getElementById(id))
    .filter(Boolean);

function updateActiveNav() {
    const scrollPos = window.scrollY + window.innerHeight * 0.35;
    let currentSection = sections[0];

    sections.forEach(section => {
        if (section.offsetTop <= scrollPos) {
            currentSection = section;
        }
    });

    mobileNavLinks.forEach(link => {
        link.classList.remove('active', 'text-[var(--color-accent)]');
        link.classList.add('text-[var(--color-text-muted)]');
    });

    const activeLink = document.querySelector(`.mobile-nav-link[data-mobile-nav="${currentSection.id}"]`);
    if (activeLink) {
        activeLink.classList.add('active', 'text-[var(--color-accent)]');
        activeLink.classList.remove('text-[var(--color-text-muted)]');
    }
}

if (mobileNavLinks.length && sections.length) {
    updateActiveNav();
    window.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateActiveNav);
    }, { passive: true });
}

// Hotel Gallery lightbox — a simple, self-contained modal for the general
// hotel photos grid (#galeria). Kept independent from room_gallery.js
// (which drives the per-room card carousels + Room Gallery Modal) so the
// two features never share click handlers or state.
(function () {
    const grid = document.querySelector('[data-hotel-gallery]');
    const modal = document.querySelector('[data-hotel-gallery-modal]');
    if (!grid || !modal) return;

    const thumbs = Array.from(grid.querySelectorAll('[data-hotel-gallery-open]'));
    const photos = thumbs.map(img => ({ src: img.src, alt: img.alt }));
    const modalImage = modal.querySelector('[data-hotel-gallery-modal-image]');
    const modalTitle = modal.querySelector('[data-hotel-gallery-modal-title]');
    const modalCounter = modal.querySelector('[data-hotel-gallery-modal-counter]');
    const prevBtn = modal.querySelector('[data-hotel-gallery-modal-prev]');
    const nextBtn = modal.querySelector('[data-hotel-gallery-modal-next]');
    let index = 0;

    function render() {
        const photo = photos[index];
        modalImage.src = photo.src;
        modalImage.alt = photo.alt;
        modalTitle.textContent = photo.alt || '';
        const hasMultiple = photos.length > 1;
        modalCounter.textContent = hasMultiple ? `${index + 1} / ${photos.length}` : '';
        prevBtn.classList.toggle('hidden', !hasMultiple);
        nextBtn.classList.toggle('hidden', !hasMultiple);
    }

    function open(startIndex) {
        index = startIndex || 0;
        render();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    function showPrev() {
        index = (index - 1 + photos.length) % photos.length;
        render();
    }

    function showNext() {
        index = (index + 1) % photos.length;
        render();
    }

    thumbs.forEach((img, i) => {
        img.addEventListener('click', () => open(i));
    });

    modal.querySelector('[data-hotel-gallery-close]').addEventListener('click', close);
    prevBtn.addEventListener('click', showPrev);
    nextBtn.addEventListener('click', showNext);

    modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
    });

    document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') showPrev();
        if (e.key === 'ArrowRight') showNext();
    });
})();
    </script>
</div>