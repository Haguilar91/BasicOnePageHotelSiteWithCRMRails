<%# The <html>/<head>/<title>/favicon here are already provided by
    app/views/layouts/application.html.erb (which this view is rendered
    inside of). Previously this file also declared its own full
    <!DOCTYPE html><html><head>...</head> document, which meant the page
    contained two nested <html>/<head>/<body> structures. That's invalid
    HTML and is why adding the Font Awesome <link> (and anything else in
    this inner <head>) behaved unreliably. Everything that's genuinely
    extra (Tailwind CDN, Google Fonts, Font Awesome, and the page's
    <style> block) is now pushed into the layout's real <head> via
    content_for(:head) instead. %>
<% content_for :head do %>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #0f172a;
        }
        
        h1, h2, h3, .font-serif {
            font-family: 'Playfair Display', serif;
        }
        
        .hero {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)),
                        url('https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1920&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .service-card {
            transition: all 0.3s ease;
        }
        
        .service-card:hover {
            transform: translateY(-5px);
        }

        .category-card {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(148, 163, 184, 0.15);
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.25);
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .category-card:hover {
            transform: translateY(-8px);
            border-color: rgba(212, 175, 55, 0.35);
        }

        .category-card h3 {
            letter-spacing: 0.02em;
        }
        
        .room-card {
            transition: all 0.4s ease;
        }
        
        .room-card:hover {
            transform: translateY(-10px);
        }
        
        .room-card img {
            transition: transform 0.5s ease;
        }
        
        .room-card:hover img {
            transform: scale(1.1);
        }
        
        .btn-gold {
            background: linear-gradient(135deg, #d4af37 0%, #f4e4bc 50%, #d4af37 100%);
            background-size: 200% 200%;
            animation: shine 3s ease infinite;
        }
        
        @keyframes shine {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        .floating {
            animation: floating 3s ease-in-out infinite;
        }
        
        @keyframes floating {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }
        
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease;
        }
        
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
        
        .nav-link {
            position: relative;
        }
        
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background-color: #d4af37;
            transition: width 0.3s ease;
        }
        
        .nav-link:hover::after {
            width: 100%;
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #d4af37 0%, #f4e4bc 50%, #d4af37 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .testimonial-card {
            background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        }
    </style>
<% end %>

