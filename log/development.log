411:        <script>
412:            // Smooth scrolling for navigation links
413:            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
414:                anchor.addEventListener('click', function (e) {
415:                    e.preventDefault();
416:                    const target = document.querySelector(this.getAttribute('href'));
417:                    if (target) {
418:                        target.scrollIntoView({
419:                            behavior: 'smooth',
420:                            block: 'start'
421:                        });
422:                    }
423:                });
424:            });
425:    
426:            // Fade in animation on scroll
427:            const observerOptions = {
428:                root: null,
429:                rootMargin: '0px',
430:                threshold: 0.1
431:            };
432:    
433:            const observer = new IntersectionObserver((entries, observer) => {
434:                entries.forEach(entry => {
435:                    if (entry.isIntersecting) {
436:                        entry.target.classList.add('visible');
437:                        observer.unobserve(entry.target);
438:                    }
439:                });
440:            }, observerOptions);
441:    
442:            document.querySelectorAll('.fade-in').forEach(el => {
443:                observer.observe(el);
444:            });
445:    
446:            // Navbar background on scroll
447:            const nav = document.querySelector('nav');
448:            window.addEventListener('scroll', () => {
449:                if (window.scrollY > 100) {
450:                    nav.classList.add('bg-slate-900/95');
451:                } else {
452:                    nav.classList.remove('bg-slate-900/95');
453:                }
454:            });
455:    
456:            // Handle hero image upload
457:            document.getElementById('hero-image-form').addEventListener('submit', function(e) {
458:                e.preventDefault();
459:                const fileInput = document.getElementById('hero-image-input');
460:                const file = fileInput.files[0];
461:                if (file) {
462:                    const formData = new FormData();
463:                    formData.append('hero_image', file);
464:                    fetch('/update_hero_image', {
465:                        method: 'POST',
466:                        body: formData
467:                    })
468:                    .then(response => response.redirect())
469:                    .catch(error => console.error('Error uploading image:', error));
470:                }
471:            });
472:        </script>
473:    </body>
